{
    "manifest_version": 3,
    "name": "DeBaiter",
    "version": "1.0",
    "description": "",
    "permissions": ["activeTab", "scripting"],
    "content_scripts": [
      {
        "matches": ["*://*.facebook.com/*"],
        "js": ["content.js"],
        "run_at": "document_end"
      }
    ],
    "host_permissions": ["*://*/*"]
  }
  